label arc_character_day1_scene5:
    scene bg jalan_d4_kantin with dissolve:
        size (config.screen_width, config.screen_height)
        truecenter

    show tessa kasual_kesal:
        xalign 0.5
        zoom tessa_default.zoom
        yalign tessa_default.yalign
    with dissolve

    tessa "\"{size=+10}HEY! DIEM DULU BISA GAK!!{/size}\"" with vpunch

    hide tessa with dissolve

    show raden kasual_gugup:
        xalign 0.45
        zoom raden_default.zoom
        yalign raden_default.yalign
    with dissolve

    raden "\"Kak Tessa?!\""

    hide raden with dissolve

    anon "\"Tess, lu liat sendiri kan mereka—\""

    show tessa kasual_kesal:
        xalign 0.5
        zoom tessa_default.zoom
        yalign tessa_default.yalign
    with dissolve

    "Tessa menatap pria itu dengan aura yang mencekam, membuat seluruh mahasiswa yang ada di ruangan ini tegang dan takut."

    tessa "\"Dio, aku dah bilang untuk diem dulu kan\""

    "Pria perokok itu yang ternyata bernama Dio, akhirnya menciut, tak berani membalas perkataan Kak Tessa."

    "Tessa melihat sekeliling, dia melihat di antara semua orang di sini, dan melihat dari tadi Santo berdiri diam mengamati dengan kepala dingin."

    tessa "\"Hey gondrong! Coba jelaskan!\""

    show tessa:
        xalign 1.0
        zoom tessa_default.zoom
        yalign tessa_default.yalign
    with moveinleft

    show santo kasual_terkejut:
        xalign 0.0
        zoom santo_default.zoom
    with dissolve

    santo "\"?!!\""

    show santo kasual_bicara:

        zoom santo_default.zoom
    santo "\"Ehm..\""

    "Santo berjalan maju pelan, menghela nafas dengan tangan menggaruk bagian belakang lehernya."

    santo "\"Kak Dio ini. Tadi di Kantin sempat merokok dan membuangnya sembarang, salah satu teman ku mencoba memperingati nya, dan yah—\""

    "Santo mengangkat kedua bahunya. Lalu melihat Kak Dio dengan tatapan tajam."

    "Kak Dio gugup, menelan ludahnya sendiri."

    santo "\"Inilah hasilnya\""

    show santo kasual_netral:

        zoom santo_default.zoom
    dio "\"Hei, jangan fitnah! Gue ngerokok di luar kantin tadi, cuma mampir ke sana buat beli minum!\""

    show santo kasual_bicara:

        zoom santo_default.zoom
    santo "\"Mungkin Kak Tessa bisa tanya Kak Sekar. Dia tadi ada di sana waktu semuanya mulai.\""

    show santo kasual_netral:
        zoom santo_default.zoom
    show tessa kasual_serius:

        zoom tessa_default.zoom
        yalign tessa_default.yalign
    tessa "\"Tessa mengangguk, tanpa berkata apa-apa. Dia langsung mengambil ponselnya dan menekan nomor. \""

    tessa "\"Gimana Dio? Benar kah? Perlu kah ku telfon Sekar buat memastikan?\""

    dio "\"I..itu.. Aku...\""

    hide santo with dissolve

    show tessa:
        xalign 0.5
        zoom tessa_default.zoom
        yalign tessa_default.yalign
    with moveinright

    show tessa kasual_nafas with dissolve:
        zoom tessa_default.zoom
        yalign tessa_default.yalign
    pause 0.3
    show tessa kasual_netral with dissolve:

        zoom tessa_default.zoom
        yalign tessa_default.yalign
    tessa "\"Maaf, karena dia telah merepotkan kalian, sisanya biar aku urus.\""

    "Akhirnya, Tessa mencengkram bahu Kak Dio dan membawa nya pergi dengan langkah berat, mulutnya masih menggumamkan ketidakpuasan."

    "Kami hanya bisa mengangguk dan berterima kasih pada Kak Tessa."

    hide tessa with dissolve

    show santo kasual_netral:
        xalign 0.25
        zoom santo_default.zoom
    show erin kasual_netral:
        xalign 0.85
        zoom erin_default.zoom
        yalign erin_default.yalign
    show aisyah casual_serius:
        xalign 1.45
        zoom aisyah_default.zoom
        yalign aisyah_default.yalign
    show raden kasual_canggung:
        xalign -0.45
        zoom raden_default.zoom
        yalign raden_default.yalign
    with dissolve

    "Kami hanya saling melirik, suasana mulai tenang lagi."

    "Aisyah terdiam, sepertinya masih tegang."

    "Erin menoleh ke arahku, senyumnya tipis namun matanya menyiratkan rasa lega."

    erin "\"Untung dia cepat datang... aku nggak yakin masalah tadi selesai kalau cuma kita.\""

    "Erin tertawa kecil, mencoba meredakan sisa ketegangan."

    show santo kasual_bicara:

        zoom santo_default.zoom
    santo "\"Kayaknya... ke perpusnya besok aja, ya?\""

    show santo kasual_netral:
        zoom santo_default.zoom
    show raden kasual_gugup:

        zoom raden_default.zoom
        yalign raden_default.yalign
    raden "\"Aku sih udah nggak sanggup buka buku hari ini. Jiwa dan raga perlu di-reset.\""

    show raden kasual_canggung:

        zoom raden_default.zoom
        yalign raden_default.yalign
    erin "\"Iya, kayaknya lebih baik kita istirahat dulu aja hari ini...\""

    show aisyah casual_menghela_napas with dissolve:
        zoom aisyah_default.zoom
        yalign aisyah_default.yalign
    pause 0.3
    show aisyah casual_sedih with dissolve:

        zoom aisyah_default.zoom
        yalign aisyah_default.yalign
    "Aisyah menghela napas, matanya menatap langit yang mulai menguning."

    aisyah "\"Setuju...\""

    return
