label pensasi_sekar_scene2:
    #kelas D4
    scene bg kelas_d4 with dissolve

    show raden jas_biasa:
        xalign -0.2
        zoom raden_default.zoom
        yalign raden_default.yalign
    show sekar kasual_bicara:
        xalign 1.0
        zoom sekar_default.zoom
        yalign sekar_default.yalign
    with dissolve

    voice "audio/vo/sekar/pensasi/pensasi_2_1_ingat.ogg"
    sekar "\"Ingat ya den! Nanti pas menitnya udah menunjukkan 00, kamu harus pergi ke panggung.\""

    voice "audio/vo/sekar/pensasi/pensasi_2_2_terus.ogg"
    sekar "\"Terus lanjutkan dengan sapaan dan salam, yang dilanjutkan dengan perkenalan\""

    voice "audio/vo/sekar/pensasi/pensasi_2_3_setelah.ogg"
    sekar "\"Setelah perkenalan, kamu langsung ucapkan selamat datang di PENSASI PENS 2024. Terserah kamu mau ngucapinnya gimana, yang penting sopan santun peribahasanya kamu jaga\""

    show sekar kasual_biasa:
        zoom sekar_default.zoom
        yalign sekar_default.yalign
    show raden jas_tersenyum:

        zoom raden_default.zoom
        yalign raden_default.yalign
    raden "\"Siap kak\""

    show sekar kasual_bicara:
        zoom sekar_default.zoom
        yalign sekar_default.yalign
    show raden jas_biasa:

        zoom raden_default.zoom
        yalign raden_default.yalign
    voice "audio/vo/sekar/pensasi/pensasi_2_4_ok.ogg"
    sekar "\"Ok, breifing nya gitu dulu ya. ada yang mau ditanyaain nggak?\""

    show sekar kasual_biasa:
        zoom sekar_default.zoom
        yalign sekar_default.yalign
    show raden jas_tersenyum:

        zoom raden_default.zoom
        yalign raden_default.yalign
    raden "\"Sudah cukup kak\""

    show sekar kasual_bicara:
        zoom sekar_default.zoom
        yalign sekar_default.yalign
    show raden jas_biasa:

        zoom raden_default.zoom
        yalign raden_default.yalign
    voice "audio/vo/sekar/pensasi/pensasi_2_5_baiklah.ogg"
    sekar "\"Baiklah, kalau begitu, kamu pergi ke sebelahnya panggung dan tunggu sampai waktunya kamu tampil!\""

    scene black with dissolve:
        size (config.screen_width, config.screen_height)
        truecenter
    with Pause(0.3)

    scene bg auditorium with dissolve:
        size (config.screen_width, config.screen_height)
        truecenter

    show aisyah casual_bingung:
        xalign 1.0
        zoom aisyah_default.zoom
        yalign aisyah_default.yalign
    show fania casual_dingin:
        xalign -0.2
        zoom fania_default.zoom
        yalign fania_default.yalign
    with dissolve

    aisyah "\"Raden dimana ya? Dia yang mengajak, tapi dia sendiri yang nggak ada\""

    show fania casual_menghelanapas:

        zoom fania_default.zoom
        yalign fania_default.yalign
    fania "\"Tau begini, mending aku pergi jalan-jalan ke booth-booth yang ada aja\""

    show aisyah casual_terkejut:
        zoom aisyah_default.zoom
        yalign aisyah_default.yalign
    show fania casual_dingin:

        zoom fania_default.zoom
        yalign fania_default.yalign
    aisyah "\"Eh, Fan. Itu yang di depan panggun sana terlihat kayak si Raden ya?\""

    show fania casual_bingung:

        zoom fania_default.zoom
        yalign fania_default.yalign
    fania "\"Mana?\""

    aisyah "\"Itu loh, yang disebelah panggung\""

    show fania casual_terkejut:

        zoom fania_default.zoom
        yalign fania_default.yalign
    fania "\"Lah iya, Raden itu\""

    fania "\"Tu anak ngapain dah\""

    aisyah "\"Eh, sudah dimulai nih\""

    scene black with dissolve:
        size (config.screen_width, config.screen_height)
        truecenter
    with Pause(0.3)

    scene bg auditorium with dissolve:
        size (config.screen_width, config.screen_height)
        truecenter

    show raden jas_biasa:
        xalign 0.45
        zoom raden_default.zoom
        yalign raden_default.yalign
    with dissolve

    raden "\"Sudah waktunya nih\""

    show raden jas_ceria with dissolve:

        zoom raden_default.zoom
        yalign raden_default.yalign
    "Dengan mengeluarkan muka yang ceria, aku berjalan sambil menatap orang-orang yang datang. Di tengah keramaian, dapat terlihat Fania dan Aisyah yang duduk bersebelahan melambaikan tangannya ke aku."

    show raden jas_tersenyum with dissolve:

        zoom raden_default.zoom
        yalign raden_default.yalign
    raden "\"Assalamualaikum Wr. Wb. Salam sejahtera untuk kita semua, Shalom, Om Swastyastu, Namo Buddhaya, Dan Salam Kebajikan\""

    raden "\"Yang saya hormati, Para undangan yang berbahagia. Serta seluruh hadirin yang saya cintai.\""

    raden "\"Puji dan syukur kita panjatkan kepada Tuhan Yang Maha Esa, karena atas rahmat dan karunia-Nya, pada hari ini kita semua dapat berkumpul bersama di tempat yang penuh berkah ini, dalam keadaan sehat wal afiat, untuk menghadiri acara PENSASI ini.\""

    raden "\"Izinkan saya memperkenalkan diri, nama saya Raden, dan pada kesempatan istimewa ini saya diberi kepercayaan untuk memandu jalannya acara.\""

    raden "\"Saya merasa sangat terhormat berdiri di hadapan hadirin yang luar biasa, yang datang dengan semangat kebersamaan dan persaudaraan.\""

    raden "\"Tanpa memperpanjang waktu, mari kita mulai acara PENSASI PENS 2024.\""

    raden "\"Beri tepuk tangan semuanya\""

    "Dengan langkah yang mantap, aku turun dari panggung, menyerahkan panggung selanjutnya kepada pengisi acara berikutnya. Namun, dalam hatiku, aku tahu momen ini akan terus terpatri sebagai awal dari sesuatu yang istimewa."

    scene bg auditorium with dissolve:
        size (config.screen_width, config.screen_height)
        truecenter

    show aisyah casual_bersemangat:
        xalign 1.0
        zoom aisyah_default.zoom
        yalign aisyah_default.yalign
    show fania casual_senyum_ceria:
        xalign -0.2
        zoom fania_default.zoom
        yalign fania_default.yalign
    with dissolve

    aisyah "\"Nggak nyangka si Raden malah menjadi MC nya\""

    fania "\"Iya sih, nggak expect, tiba-tiba saja jadi MC tu anak\""

    #kelas D4
    scene bg kelas_d4 with dissolve

    show raden jas_biasa:
        xalign -0.2
        zoom raden_default.zoom
        yalign raden_default.yalign
    show sekar kasual_bicara:
        xalign 1.0
        zoom sekar_default.zoom
        yalign sekar_default.yalign
    with dissolve

    voice "audio/vo/sekar/pensasi/pensasi_2_6_den.ogg"
    sekar "\"Den\""

    show raden jas_tersenyum:
        zoom raden_default.zoom
        yalign raden_default.yalign
    show sekar kasual_biasa:

        zoom sekar_default.zoom
        yalign sekar_default.yalign
    raden "\"Oh, Kak Sekar\""

    show sekar kasual_bicara:
        zoom sekar_default.zoom
        yalign sekar_default.yalign
    show raden jas_biasa:

        zoom raden_default.zoom
        yalign raden_default.yalign
    voice "audio/vo/sekar/pensasi/pensasi_2_7_ini.ogg"
    sekar "\"Ini, untuk MC nya sudah datang, makasih banget ya den\""

    show sekar kasual_biasa:

        zoom sekar_default.zoom
        yalign sekar_default.yalign
    abdi "\"Iya makasih ya dik\""

    show raden jas_ceria:
    
        zoom raden_default.zoom
        yalign raden_default.yalign
    raden "\"Nggak papa kok kak, aku juga jadi ngerasain feel yang menegangkan seperti ini\""

    abdi "\"Wih begitu ya dik?\""

    show raden jas_tersenyum:

        zoom raden_default.zoom
        yalign raden_default.yalign
    raden "\"Iya kak\""

    show raden jas_biasa:
        zoom raden_default.zoom
        yalign raden_default.yalign
    show sekar kasual_bicara:

        zoom sekar_default.zoom
        yalign sekar_default.yalign
    voice "audio/vo/sekar/pensasi/pensasi_2_8_abdi.ogg"
    sekar "\"Abdi, kamu langsung siap-siap dulu sana\""

    show sekar kasual_biasa:

        zoom sekar_default.zoom
        yalign sekar_default.yalign
    abdi "\"Ok, Sekar. Dan untuk kamu yang disana, namamu siapa?\""

    show raden jas_tersenyum:

        zoom raden_default.zoom
        yalign raden_default.yalign
    raden "\"Oh, aku Raden kak\""

    show raden jas_biasa:

        zoom raden_default.zoom
        yalign raden_default.yalign
    abdi "\"Raden ya? Salam kenal den. Aku Abdi\""

    show raden jas_ceria:

        zoom raden_default.zoom
        yalign raden_default.yalign
    raden "\"Salam kenal Kak Abdi\""

    show sekar kasual_teriak:
        zoom sekar_default.zoom
        yalign sekar_default.yalign
    show raden jas_biasa:

        zoom raden_default.zoom
        yalign raden_default.yalign
    voice "audio/vo/sekar/pensasi/pensasi_2_9_udah.ogg"
    sekar "\"Udah pergi sana di\""

    abdi "\"Iya-iya kar\""

    show sekar kasual_bicara:

        zoom sekar_default.zoom
        yalign sekar_default.yalign
    voice "audio/vo/sekar/pensasi/pensasi_2_10_aman_kan.ogg"
    sekar "\"Aman kan den?\""

    show sekar kasual_biasa:
        zoom sekar_default.zoom
        yalign sekar_default.yalign
    show raden jas_tersenyum:

        zoom raden_default.zoom
        yalign raden_default.yalign
    raden "\"Aman kak\""

    show raden jas_biasa:

        zoom raden_default.zoom
        yalign raden_default.yalign
    raden "\"Oh iya, kak. Untuk hadiah spesial yang dimaksud itu dapat apa?\""

    voice "audio/vo/sekar/pensasi/pensasi_2_11_terserah.ogg"
    sekar "\"Terserah kamu sih, kamu maunya apa?\""

    menu:
        "Lain kali aja, mau kembali ke Aisyah dan Fania":
            jump pensasi_sekar_scene2_choice2_1
        "Jalan-jalan ke booth bareng yuk kak":
            jump pensasi_sekar_scene2_choice2_2

    return

label pensasi_sekar_scene2_choice2_1:
    show raden jas_tersenyum:
        zoom raden_default.zoom
        yalign raden_default.yalign
    raden "\"Bagaimana kalau traktir aku Ayam Malaysia lain kali kak?\""

    show raden jas_biasa:
        zoom raden_default.zoom
        yalign raden_default.yalign
    show sekar kasual_bingung:

        zoom sekar_default.zoom
        yalign sekar_default.yalign
    voice "audio/vo/sekar/pensasi/pensasi_2_1_1_kenapa.ogg"
    sekar "\"Kenapa nggak sekarang aja den?\""

    show raden jas_tersenyum:

        zoom raden_default.zoom
        yalign raden_default.yalign
    raden "\"Aku mau pergi ke temanku kak\""

    show sekar kasual_biasa:

        zoom sekar_default.zoom
        yalign sekar_default.yalign
    voice "audio/vo/sekar/pensasi/pensasi_2_1_2_begitu.ogg"
    sekar "\"Begitu?\""

    show sekar kasual_ceria:

        zoom sekar_default.zoom
        yalign sekar_default.yalign
    voice "audio/vo/sekar/pensasi/pensasi_2_1_3_baiklah.ogg"
    sekar "\"Baiklah kalau begitu, selamat bersenang-senang dengan temanmu\""
    
    "Setelah berpamitan dengan Kak Sekar, aku langsung pergi menuju Auditorium untuk menonton pitch bersama dengan Aisyah dan Fania."

    scene bg depan_pasca_ramai with dissolve:
        size (config.screen_width, config.screen_height)
        truecenter

    "Di tengah jalan, terlihat Fania yang sedang keluar dari Auditorium."

    show raden kasual_tersenyum:
        xalign -0.2
        zoom raden_default.zoom
        yalign raden_default.yalign
    show fania casual_dingin:
        xalign 1.3
        zoom fania_default.zoom
        yalign fania_default.yalign
    with dissolve

    raden "\"Fania\""

    show fania casual_senyum_normal_biasa:

        zoom fania_default.zoom
        yalign fania_default.yalign
    fania "\"Huh? Oh, Raden.\""

    fania "\"Gimana perasaan jadi MC nya? Menyenangkan?\""

    show raden kasual_ceria:

        zoom raden_default.zoom
        yalign raden_default.yalign
    raden "\"Yaa... daripada senang, lebih ke seru sih\""

    fania "\"Kenapa tuh?\""

    show raden kasual_tersenyum:

        zoom raden_default.zoom
        yalign raden_default.yalign
    raden "\"Berdiri di atas panggung sambil dilihatin banyak orang, membuat diriku merasa tegang\""

    raden "\"Dan hal yang bikin hal ini seru adalah perasaan ketika aku bisa menaklukkan ketegangan yang kurasakan\""

    show fania casual_tertawa_kecil:

        zoom fania_default.zoom
        yalign fania_default.yalign
    fania "\"Bagus deh\""

    show fania casual_senyum_normal_biasa:

        zoom fania_default.zoom
        yalign fania_default.yalign
    fania "\"Btw, aku mau jalan-jalan nih\""

    fania "\"Mau ikut?\""

    show raden kasual_bingung:

        zoom raden_default.zoom
        yalign raden_default.yalign
    raden "\"Eh, tapi Aisyah ditinggal aja nih?\""

    fania "\"Terserah kamu sih, mau ikut atau nggak\""

    menu:
        "Daripada dengerin Pitching booth mending ikut Fania aja":
            jump pensasi_fania
        "Maaf nih, tapi aku mau masuk ke audit bersama Aisyah":
            $ from_sekar_route = True
            scene black with dissolve:
                size (config.screen_width, config.screen_height)
                truecenter
            with Pause(0.3)

            jump pensasi_aisyah_scene2

    return

label pensasi_sekar_scene2_choice2_2:
    show raden jas_tersenyum:
        zoom raden_default.zoom
        yalign raden_default.yalign
    raden "\"Gimana kalau jalan-jalan bareng ke booth-booth yang diluar kak?\""

    show raden jas_biasa:
        zoom raden_default.zoom
        yalign raden_default.yalign
    show sekar kasual_ragu:
        zoom sekar_default.zoom
        yalign sekar_default.yalign
    voice "audio/vo/sekar/pensasi/pensasi_2_2_1_tapi.ogg"
    sekar "\"Hmm, tapi sebentar lagi acara sudah mulai agak sibuk den\""

    "Tiba-tiba muncullah Kak Bima dari belakang"

    show sekar kasual_bingung:
        zoom sekar_default.zoom
        yalign sekar_default.yalign
    bima "\"Sekar, kamu kan sudah membantu banyak nih\""

    bima "\"Istirahat sekali-kali sana\""

    bima "\"Jangan terlalu memaksakan diri sendiri\""

    bima "\"Iya nggak den?\""

    show raden jas_tersenyum:

        zoom raden_default.zoom
        yalign raden_default.yalign
    raden "\"Iya kak\""

    show raden jas_biasa:
        zoom raden_default.zoom
        yalign raden_default.yalign
    show sekar kasual_gugup:

        zoom sekar_default.zoom
        yalign sekar_default.yalign
    voice "audio/vo/sekar/pensasi/pensasi_2_2_2_tapi_nanti.ogg"
    sekar "\"Tapi nanti kalaul ada apa-apa gimana Bim?\""

    bima "\"Sudah, nggak perlu dipikirin\""

    bima "\"Tim kepanitiaan nggak bakal hancur hanya karena satu orang sedang beristirahat\""

    bima "\"Sudah jalan-jalan sana\""

    show sekar kasual_hembus_nafas_kantung_mata:
        zoom sekar_default.zoom
        yalign sekar_default.yalign
    pause 0.3
    show sekar kasual_hembus_nafas with dissolve:
        zoom sekar_default.zoom
        yalign sekar_default.yalign
    pause 0.3
    show sekar kasual_hembus_nafas_kantung_mata with dissolve:

        zoom sekar_default.zoom
        yalign sekar_default.yalign
    voice "audio/vo/sekar/pensasi/pensasi_2_2_3_yasudah_deh.ogg"
    sekar "\"Ya sudah deh, iya\""

    show raden jas_ceria:

        zoom raden_default.zoom
        yalign raden_default.yalign
    raden "\"Kalau begitu ayo kak\""

    show sekar kasual_biasa:
        zoom sekar_default.zoom
        yalign sekar_default.yalign
    show raden jas_biasa:

        zoom raden_default.zoom
        yalign raden_default.yalign
    "Sambil berpergian aku menatap kak Bima dan mengacungkan jempol ku ke arahnya."

    "Kak Bima juga membalas acungan jempolku sembari tersenyum."

    stop music fadeout 2.0

    scene black with dissolve:
        size (config.screen_width, config.screen_height)
        truecenter
    with Pause(0.3)

    jump pensasi_sekar_scene3

    return
